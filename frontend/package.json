{
    "name": "conversationaly",
    "version": "1.3.0",
    "private": true,
    "_comment_typescript": "typescript is held at 6.x deliberately. TypeScript 7 is the native Go port: its npm package ships only a shim (getExePath.js, tsc.js) with no lib.*.d.ts and no tsserver.js, so `tsc` and `next build` both pass while the editor language service loses every global (Promise, Date, window, react). 6.x is a normal JS TypeScript with all 107 lib files plus tsserver. Do not bump to 7 until editors support it.",
    "scripts": {
        "_comment_webpack": "--webpack opts out of the Next 16 Turbopack default: Turbopack's next/font/google resolves dead IBM Plex woff2 URLs (404) and fails the build. Webpack fetches the same fonts fine. Drop the flag once that is fixed upstream.",
        "dev": "next dev -p 3118 --webpack",
        "build": "next build --webpack",
        "start": "next start -p 3118",
        "tauri": "tauri",
        "tauri:dev": "node scripts/tauri-auto.js dev",
        "tauri:build": "node scripts/tauri-auto.js build",
        "tauri:dev:cpu": "tauri dev",
        "tauri:dev:cuda": "tauri dev -- --features cuda",
        "tauri:dev:vulkan": "tauri dev -- --features vulkan",
        "tauri:dev:metal": "tauri dev -- --features metal",
        "tauri:dev:rocm": "tauri dev -- --features rocm",
        "tauri:build:cpu": "tauri build",
        "tauri:build:cuda": "tauri build -- --features cuda",
        "tauri:build:vulkan": "tauri build -- --features vulkan",
        "tauri:build:metal": "tauri build -- --features metal",
        "tauri:build:rocm": "tauri build -- --features rocm"
    },
    "dependencies": {
